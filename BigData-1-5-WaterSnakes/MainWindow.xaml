<Window x:Class="BD_1_5_WaterSnakes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BD_1_5_WaterSnakes"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="820">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Top Control Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Loaded File Status Text -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area with Tabs -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Controls Layout -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnLoadImage" Click="BtnLoadImage_Click" Content="Load Image" Padding="10,5" Margin="0,0,10,0"/>
            <Button x:Name="BtnRunSegmentation" Click="BtnRunSegmentation_Click" Content="Run Segmentation" Padding="10,5" Margin="0,0,15,0"/>

            <!-- Parameters Dropdown Menu with Sliders -->
            <Menu VerticalAlignment="Center" Margin="0,0,15,0" Background="Transparent">
                <MenuItem Header="Parameters ▾" Padding="8,4">
                    <StackPanel Margin="10" Width="280">

                        <!-- Parameter 1: Watershed Gaussian Kernel Size (3, 5, 7, 9, 11) -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="watershed gaussian kernel size" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="sliderWatershedGaussianKernel" Grid.Column="0" Minimum="3" Maximum="11" Ticks="3,5,7,9,11" IsSnapToTickEnabled="True" Value="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=sliderWatershedGaussianKernel, Path=Value, StringFormat={}{0:F0}}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- Parameter 2: Watershed Sure Foreground Threshold (0.1 - 0.9, step 0.1) -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="watershed sure foreground threshold" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="sliderWatershedForegroundThreshold" Grid.Column="0" Minimum="0.1" Maximum="0.9" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="0.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=sliderWatershedForegroundThreshold, Path=Value, StringFormat={}{0:F1}}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- Parameter 3: Watershed Dilation Kernel Size (3, 5, 7, 9, 11) -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="watershed dilation kernel size" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="sliderWatershedDilationKernel" Grid.Column="0" Minimum="3" Maximum="11" Ticks="3,5,7,9,11" IsSnapToTickEnabled="True" Value="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=sliderWatershedDilationKernel, Path=Value, StringFormat={}{0:F0}}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- Parameter 4: Watershed Dilation Iterations (3-30, step 1) -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="watershed dilation iterations" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="sliderWatershedDilationIterations" Grid.Column="0" Minimum="3" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=sliderWatershedDilationIterations, Path=Value, StringFormat={}{0:F0}}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- Parameter 5: Snakes Morph Kernel Size (3, 5, 7, 9, 11) -->
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="snakes morph kernel size" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="sliderSnakesMorphKernel" Grid.Column="0" Minimum="3" Maximum="11" Ticks="3,5,7,9,11" IsSnapToTickEnabled="True" Value="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=sliderSnakesMorphKernel, Path=Value, StringFormat={}{0:F0}}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </MenuItem>
            </Menu>

            <CheckBox x:Name="ChkInvertedThreshold" 
                      Content="Use inverted binary thresholding" 
                      IsChecked="False" 
                      Checked="ChkInvertedThreshold_Toggled"
                      Unchecked="ChkInvertedThreshold_Toggled"
                      VerticalAlignment="Center">
                <CheckBox.ToolTip>
                    <ToolTip>
                        <TextBlock Text="Checking this option will often produce better results for images where the background is lighter than the foreground." 
                                   MaxWidth="300" 
                                   TextWrapping="Wrap"/>
                    </ToolTip>
                </CheckBox.ToolTip>
            </CheckBox>
        </StackPanel>

        <!-- File Loaded Text with Placeholder -->
        <TextBlock x:Name="txtLoadedFile" 
                   Grid.Row="1" 
                   Text="Loaded file: None" 
                   FontStyle="Italic" 
                   Foreground="Gray" 
                   Margin="0,0,0,10" 
                   VerticalAlignment="Center"/>

        <!-- TabControl for Image Panels -->
        <TabControl x:Name="tabControl" Grid.Row="2">
            <!-- Tab 1: Originals -->
            <TabItem x:Name="tabOriginals" Header="Originals">
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Original Left Panel -->
                    <Border Grid.Column="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" ClipToBounds="True">
                        <Image x:Name="imgOriginalLeft" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Original Right Panel -->
                    <Border Grid.Column="2" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" ClipToBounds="True">
                        <Image x:Name="imgOriginalRight" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Results (Collapsed by default) -->
            <TabItem x:Name="tabResults" Header="Results" Visibility="Collapsed">
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Segmented Left Panel with Title -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtResultLeftTitle" 
                                   Grid.Row="0" 
                                   Text="Watershed" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,4"/>
                        <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" ClipToBounds="True">
                            <Image x:Name="imgSegmentedLeft" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Segmented Right Panel with Title -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtResultRightTitle" 
                                   Grid.Row="0" 
                                   Text="Snakes" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,4"/>
                        <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" ClipToBounds="True">
                            <Image x:Name="imgSegmentedRight" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>