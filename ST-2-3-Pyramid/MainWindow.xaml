<Window x:Class="ST_2_3_Pyramid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ST_2_3_Pyramid"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="950">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <UniformGrid Columns="3" HorizontalAlignment="Left" Width="485">
                <StackPanel Margin="0,0,15,0">
                    <Button x:Name="BtnLoadImage" Content="Load Image" Width="130" Height="30" Click="BtnLoadImage_Click"/>
                </StackPanel>
                <Button x:Name="BtnBuildPyramids" Content="Build Pyramids" Width="130" Height="30" IsEnabled="False" Margin="0,0,15,0" Click="BtnBuildPyramids_Click" VerticalAlignment="Top"/>
                <Button x:Name="BtnReconstructCompare" Content="Reconstruct &amp; Compare" Width="160" Height="30" IsEnabled="False" Click="BtnReconstructCompare_Click" VerticalAlignment="Top"/>
                <StackPanel VerticalAlignment="Center" Width="150">
                    <DockPanel>
                        <TextBlock Text="Pyramid Levels:" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtLevelValue" Text="4" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="SliderLevels" 
                            Minimum="2" 
                            Maximum="7" 
                            Value="4" 
                            TickFrequency="1" 
                            IsSnapToTickEnabled="True" 
                            TickPlacement="BottomRight" 
                            Margin="0,5,0,0"
                            ValueChanged="SliderLevels_ValueChanged"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>

        <TabControl x:Name="MainTabControl" Grid.Row="1">

            <!-- Tab 1: Loaded Image -->
            <TabItem x:Name="TabLoadedImage" Header="Loaded Image">
                <Grid Background="#FFF5F5F5">
                    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="10" Background="White">
                        <Image x:Name="ImgLoaded" Stretch="Uniform" Margin="5"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Pyramid Comparison (Hidden by default) -->
            <TabItem x:Name="TabPyramids" Header="Pyramid Comparison" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#FFF5F5F5">
                    <StackPanel Margin="15">
                        <TextBlock Text="Pyramid Layer Comparison" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                        <UniformGrid Columns="2">

                            <!-- Gaussian Pyramid -->
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Gaussian Pyramid Array:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <StackPanel x:Name="StackPanelGaussian" Orientation="Vertical"/>
                            </StackPanel>

                            <!-- Laplacian Pyramid -->
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Laplacian Pyramid Array:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <StackPanel x:Name="StackPanelLaplacian" Orientation="Vertical"/>
                            </StackPanel>

                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Reconstruct & Compare -->
            <TabItem x:Name="TabReconstruct" Header="Reconstruct &amp; Compare" Visibility="Collapsed">
                <Grid Margin="10" Background="#FFF5F5F5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Line of Text Above -->
                    <TextBlock x:Name="TxtReconstructInfo" Grid.Row="0" Text="Original and Reconstructed Images" FontWeight="SemiBold" FontSize="13" Margin="0,5,0,10" HorizontalAlignment="Center"/>

                    <!-- Side-by-Side Bounding Boxes -->
                    <UniformGrid Grid.Row="1" Columns="2">

                        <!-- Original Image Box -->
                        <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="5" Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Original Image" HorizontalAlignment="Center" Margin="5" FontWeight="Bold"/>
                                <!-- Height="*" forces this row to take up remaining space, scaling the image down to fit -->
                                <Image x:Name="ImgOriginal" Grid.Row="1" Stretch="Uniform" Margin="5"/>
                            </Grid>
                        </Border>

                        <!-- Reconstructed Image Box -->
                        <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="5" Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Reconstructed Image" HorizontalAlignment="Center" Margin="5" FontWeight="Bold"/>
                                <Image x:Name="ImgReconstructed" Grid.Row="1" Stretch="Uniform" Margin="5"/>
                            </Grid>
                        </Border>

                    </UniformGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
