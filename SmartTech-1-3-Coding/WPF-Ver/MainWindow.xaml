<Window x:Class="ST_1_3_Coding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ST_1_3_Coding"
        mc:Ignorable="d"
        Title="Compression Benchmark" Height="495" Width="900">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Controls -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnSelectFile" Content="Select File" Width="110" Height="30" Margin="0,0,10,0"/>
            <Button x:Name="BtnRunCompression" Content="Run Compression" Width="130" Height="30"/>
        </StackPanel>

        <!-- Selected File Status -->
        <TextBlock x:Name="TxtFilePath" Grid.Row="1" Text="No file selected." Foreground="Gray" Margin="0,0,0,15" TextTrimming="CharacterEllipsis"/>

        <!-- 4 Info Panels Side-by-Side -->
        <UniformGrid Grid.Row="2" Columns="4">

            <!-- RLE Panel -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Margin="4" Padding="10" Background="#FAFAFA">
                <StackPanel>
                    <TextBlock Text="RLE" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Speed:" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtRleSpeed" Text="0 MB/s" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Ratio:" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtRleRatio" Text="0/0 (0%)" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Round Trip Passed:" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtRleRT" Text="N/A" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Preview Snippet:" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="TxtRlePreview" Text="[Encoded data snippet]" IsReadOnly="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" Background="#F0F0F0" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Huffman Panel -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Margin="4" Padding="10" Background="#FAFAFA">
                <StackPanel>
                    <TextBlock Text="Huffman" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Speed:" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtHuffmanSpeed" Text="0 MB/s" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Ratio:" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtHuffmanRatio" Text="0/0 (0%)" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Round Trip Passed:" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtHuffmanRT" Text="N/A" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Preview Snippet:" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="TxtHuffmanPreview" Text="[Encoded data snippet]" IsReadOnly="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" Background="#F0F0F0" Margin="0,4,0,0"/>
                    <CheckBox x:Name="CheckHuffman" Content="Preview as bit stream" IsChecked="False" Margin="10" Click="CheckBox_Toggled"/>
                </StackPanel>
            </Border>

            <!-- Arithmetic Panel -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Margin="4" Padding="10" Background="#FAFAFA">
                <StackPanel>
                    <TextBlock Text="Arithmetic" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Speed:" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtArithmeticSpeed" Text="0 MB/s" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Ratio:" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtArithmeticRatio" Text="0/0 (0%)" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Round Trip Passed:" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtArithmeticRT" Text="N/A" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Preview Snippet:" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="TxtArithmeticPreview" Text="[Encoded data snippet]" IsReadOnly="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" Background="#F0F0F0" Margin="0,4,0,0"/>
                    <CheckBox x:Name="CheckArithmetic" Content="Preview as float" IsChecked="False" Margin="10" Click="CheckBox_Toggled"/>
                </StackPanel>
            </Border>

            <!-- CABAC Panel -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Margin="4" Padding="10" Background="#FAFAFA">
                <StackPanel>
                    <TextBlock Text="CABAC" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Speed:" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtCabacSpeed" Text="0 MB/s" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Ratio:" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtCabacRatio" Text="0/0 (0%)" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Round Trip Passed:" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtCabacRT" Text="N/A" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Preview Snippet:" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="TxtCabacPreview" Text="[Encoded data snippet]" IsReadOnly="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" Background="#F0F0F0" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

        </UniformGrid>
    </Grid>
</Window>